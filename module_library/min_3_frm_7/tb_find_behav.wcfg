<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_find_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_find" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="9,995 ps"></ZoomStartTime>
      <ZoomEndTime time="10,001 ps"></ZoomEndTime>
      <Cursor1Time time="10,000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="340"></NameColumnWidth>
      <ValueColumnWidth column_width="155"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="3" />
   <wvobject fp_name="/tb_find/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_find/i_m" type="array">
      <obj_property name="ElementShortName">i_m[0:6][3:0]</obj_property>
      <obj_property name="ObjectShortName">i_m[0:6][3:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_find/o_idx" type="array">
      <obj_property name="ElementShortName">o_idx[0:2][2:0]</obj_property>
      <obj_property name="ObjectShortName">o_idx[0:2][2:0]</obj_property>
   </wvobject>
</wave_config>
